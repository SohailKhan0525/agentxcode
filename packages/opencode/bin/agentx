#!/usr/bin/env node

import childProcess from "node:child_process"
import fs from "node:fs"
import path from "node:path"
import os from "node:os"
import { fileURLToPath } from "node:url"

const __filename = fileURLToPath(import.meta.url)
const scriptPath = fs.realpathSync(__filename)
const scriptDir = path.dirname(scriptPath)
const packageDir = path.resolve(scriptDir, "..")

function getVersion() {
  try {
    const pkg = JSON.parse(fs.readFileSync(path.join(packageDir, "package.json"), "utf8"))
    if (pkg.version) return pkg.version
  } catch {
    // ignore
  }
  return "3.0.4"
}

const currentVersion = getVersion()
process.env.AGENTX_VERSION = process.env.AGENTX_VERSION || currentVersion
process.env.OPENCODE_VERSION = process.env.OPENCODE_VERSION || currentVersion

const cliArgs = process.argv.slice(2)
if (
  cliArgs.length === 1 &&
  (cliArgs[0] === "--version" ||
    cliArgs[0] === "-v" ||
    cliArgs[0] === "version" ||
    cliArgs[0] === "-version")
) {
  console.log(currentVersion)
  process.exit(0)
}

const forwardedSignals = ["SIGINT", "SIGTERM", "SIGHUP"]

function run(target, args) {
  const child = childProcess.spawn(target, args, {
    stdio: "inherit",
    shell: isWin && (target.endsWith(".cmd") || target.endsWith(".bat")),
  })

  child.on("error", (error) => {
    console.error(error.message)
    process.exit(1)
  })

  const forwarders = {}
  for (const signal of forwardedSignals) {
    forwarders[signal] = () => {
      try {
        child.kill(signal)
      } catch {
        // The child may have already exited.
      }
    }
    process.on(signal, forwarders[signal])
  }

  child.on("exit", (code, signal) => {
    for (const forwardedSignal of forwardedSignals) {
      process.removeListener(forwardedSignal, forwarders[forwardedSignal])
    }

    if (signal) {
      process.kill(process.pid, signal)
      return
    }

    process.exit(typeof code === "number" ? code : 0)
  })
}

const envPath = process.env.AGENTX_BIN_PATH || process.env.OPENCODE_BIN_PATH

const platformMap = {
  darwin: "darwin",
  linux: "linux",
  win32: "windows",
}
const archMap = {
  x64: "x64",
  arm64: "arm64",
  arm: "arm",
}

const platform = platformMap[os.platform()] || os.platform()
const arch = archMap[os.arch()] || os.arch()
const isWin = os.platform() === "win32"
const exeExt = isWin ? ".exe" : ""

function supportsAvx2() {
  if (arch !== "x64") return false

  if (platform === "linux") {
    try {
      return /(^|\s)avx2(\s|$)/i.test(fs.readFileSync("/proc/cpuinfo", "utf8"))
    } catch {
      return false
    }
  }

  if (platform === "darwin") {
    try {
      const result = childProcess.spawnSync("sysctl", ["-n", "hw.optional.avx2_0"], {
        encoding: "utf8",
        timeout: 1500,
      })
      if (result.status !== 0) return false
      return (result.stdout || "").trim() === "1"
    } catch {
      return false
    }
  }

  if (platform === "windows") {
    const cmd =
      '(Add-Type -MemberDefinition "[DllImport(""kernel32.dll"")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)'

    for (const exe of ["powershell.exe", "pwsh.exe", "pwsh", "powershell"]) {
      try {
        const result = childProcess.spawnSync(exe, ["-NoProfile", "-NonInteractive", "-Command", cmd], {
          encoding: "utf8",
          timeout: 3000,
          windowsHide: true,
        })
        if (result.status !== 0) continue
        const out = (result.stdout || "").trim().toLowerCase()
        if (out === "true" || out === "1") return true
        if (out === "false" || out === "0") return false
      } catch {
        continue
      }
    }
    return false
  }

  return false
}

function findBinary() {
  // 1. Direct binaries in the package bin/ folder
  for (const name of ["agentx", "opencode"]) {
    const local = path.join(scriptDir, name + exeExt)
    if (fs.existsSync(local) && local !== __filename) return local
  }

  // 2. Local dist folder from builds
  const distPatterns = [
    `opencode-${platform}-${arch}`,
    `agentx-${platform}-${arch}`,
  ]
  if (arch === "x64" && !supportsAvx2()) {
    distPatterns.unshift(`opencode-${platform}-${arch}-baseline`)
    distPatterns.unshift(`agentx-${platform}-${arch}-baseline`)
  }

  for (const pattern of distPatterns) {
    for (const name of ["opencode", "agentx"]) {
      const distCandidate = path.join(packageDir, "dist", pattern, "bin", name + exeExt)
      if (fs.existsSync(distCandidate)) return distCandidate
    }
  }

  // 3. Search upward in node_modules for platform packages
  let current = scriptDir
  for (;;) {
    const modules = path.join(current, "node_modules")
    if (fs.existsSync(modules)) {
      for (const pattern of distPatterns) {
        for (const name of ["opencode", "agentx"]) {
          const candidates = [
            path.join(modules, `@agent-qofeno/${pattern}`, "bin", name + exeExt),
            path.join(modules, pattern, "bin", name + exeExt),
          ]
          for (const cand of candidates) {
            if (fs.existsSync(cand)) return cand
          }
        }
      }
    }
    const parent = path.dirname(current)
    if (parent === current) break
    current = parent
  }

  return null
}

function findBun() {
  const home = os.homedir()
  const appData = process.env.APPDATA || path.join(home, "AppData", "Roaming")
  const localAppData = process.env.LOCALAPPDATA || path.join(home, "AppData", "Local")

  const directCandidates = [
    path.join(appData, "npm", "node_modules", "bun", "bin", "bun.exe"),
    path.join(home, ".bun", "bin", isWin ? "bun.exe" : "bun"),
    path.join(localAppData, "bun", "bun.exe"),
    path.join(process.env.PROGRAMFILES || "", "bun", "bun.exe"),
    "/usr/local/bin/bun",
    "/opt/homebrew/bin/bun",
  ]
  for (const c of directCandidates) {
    if (c && fs.existsSync(c)) return c
  }

  try {
    const checkCmd = isWin ? "where.exe" : "which"
    const res = childProcess.spawnSync(checkCmd, ["bun"], { encoding: "utf8" })
    if (res.status === 0 && res.stdout.trim()) {
      const lines = res.stdout.trim().split(/\r?\n/)
      for (const line of lines) {
        if (isWin && line.toLowerCase().endsWith(".exe")) {
          return line
        }
        if (!isWin && fs.existsSync(line)) return line
      }
      for (const line of lines) {
        if (isWin && line.toLowerCase().endsWith(".cmd")) {
          return line
        }
      }
      if (lines[0] && fs.existsSync(lines[0])) return lines[0]
    }
  } catch {
    // ignore
  }

  return null
}

async function ensureBinary() {
  const binary = findBinary()
  if (binary) return binary

  const target = path.join(scriptDir, "agentx" + exeExt)
  if (fs.existsSync(target)) return target

  const platform = platformMap[os.platform()]
  const arch = archMap[os.arch()]
  if (!platform || !arch) return null

  console.log(`\x1b[93;1mAgentX Code\x1b[0m: Initializing ${platform}-${arch} binary...`)
  const releaseTag = "v3.0.1"
  const archiveExt = isWin ? ".zip" : ".tar.gz"
  const archiveName = `agentx-${platform}-${arch}${archiveExt}`
  const downloadUrl = `https://github.com/SohailKhan0525/agentxcode/releases/download/${releaseTag}/${archiveName}`

  const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "agentx-init-"))
  const archivePath = path.join(tempDir, archiveName)

  try {
    const res = await fetch(downloadUrl, { redirect: "follow" })
    if (!res.ok) return null
    const arrayBuffer = await res.arrayBuffer()
    fs.writeFileSync(archivePath, Buffer.from(arrayBuffer))

    childProcess.spawnSync("tar", ["-xf", archivePath, "-C", tempDir], {
      windowsHide: true,
      stdio: "ignore",
    })

    const extracted = path.join(tempDir, "agentx" + exeExt)
    if (fs.existsSync(extracted)) {
      fs.copyFileSync(extracted, target)
      if (!isWin) fs.chmodSync(target, 0o755)
      return target
    }
  } catch {
    return null
  } finally {
    try {
      fs.rmSync(tempDir, { recursive: true, force: true })
    } catch {
      // ignore
    }
  }
  return null
}

const resolved = envPath || (await ensureBinary())

if (resolved) {
  run(resolved, process.argv.slice(2))
} else {
  const srcEntry = path.join(packageDir, "src", "index.ts")
  const bun = findBun()

  if (fs.existsSync(srcEntry) && bun) {
    run(bun, ["run", srcEntry, ...process.argv.slice(2)])
  } else {
    console.error(
      [
        "\x1b[93;1mAgentX Code\x1b[0m",
        "",
        "Unable to find or initialize the AgentX Code runtime.",
        "Please check your internet connection or install Bun:",
        "",
        "  Linux / macOS:",
        "    curl -fsSL https://bun.sh/install | bash",
        "",
        "  Windows (PowerShell):",
        '    powershell -c "irm bun.sh/install.ps1 | iex"',
        "",
        "Then restart your terminal and run 'agentx' again.",
      ].join("\n"),
    )
    process.exit(1)
  }
}
